AUTOPPT_DOMAIN=ppt.example.com
AUTOPPT_ADMIN_USER=admin
AUTOPPT_TEXT_BASE_URL=https://api.openai.com/v1
AUTOPPT_TEXT_MODEL=gpt-5.4-mini
AUTOPPT_IMAGE_BASE_URL=https://api.openai.com/v1
AUTOPPT_IMAGE_MODEL=gpt-image-2.5-sunburst
AUTOPPT_MODEL_CONCURRENCY=2
AUTOPPT_SIGNUP_IMAGE_CREDITS=20
AUTOPPT_DAILY_MODEL_CALLS=2000
AUTOPPT_USER_DAILY_MODEL_CALLS=300
AUTOPPT_MAX_WORKSPACES=10

# 可选：显示在官网账号帮助与数据说明中；不配置时引导用户联系邀请人
AUTOPPT_SUPPORT_EMAIL=
AUTOPPT_SUPPORT_URL=
