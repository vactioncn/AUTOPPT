{
  "name": "autoppt",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "start": "node scripts/serve.mjs",
    "build": "tsc -b && vite build && node scripts/build-intro.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:browser": "BROWSER_TEST=1 node --test tests/workflow.test.mjs",
    "intro:screenshots": "node scripts/capture-intro.mjs",
    "deploy:intro": "node scripts/deploy-intro.mjs",
    "start:hosted": "node server/hosted/index.mjs",
    "desktop": "electron .",
    "build:mac": "npm run build && node scripts/build-mac.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "cheerio": "^1.2.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "multer": "^2.0.2",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.5.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "main": "desktop/main.cjs",
  "productName": "AutoPPT"
}
